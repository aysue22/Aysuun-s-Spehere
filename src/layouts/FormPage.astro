---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	wide?: boolean;
}
const { title, description, wide } = Astro.props;
---
<html lang="tr">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			html, body {
				margin: 0;
				padding: 0;
				width: 100%;
				overflow-x: hidden;
			}

			body {
				background-color: #2d3e2d !important;
				margin: 0;
				padding: 0;
				font-family: 'Crimson Text', serif !important;
				background-image: radial-gradient(#000 0.5px, transparent 0.5px) !important;
				background-size: 5px 5px !important;
				background-attachment: fixed !important;
			}

			main.form-main {
				max-width: 640px;
				margin: 50px auto;
				background: #fdfaf1 !important;
				padding: 50px;
				border-radius: 5px;
				box-shadow: 0 0 50px rgba(0, 0, 0, 0.5);
				border: 1px solid #d4af37;
				color: #2c2c2c;
			}

			main.form-main.wide {
				max-width: 900px;
			}

			main.form-main h1 {
				font-family: 'Crimson Text', serif;
				text-transform: uppercase;
				letter-spacing: 1px;
				border-bottom: 2px solid #3e2723;
				padding-bottom: 12px;
				margin-bottom: 24px;
				color: #1a1a1a;
			}

			main.form-main h2 {
				font-family: 'Crimson Text', serif;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				font-size: 1.3rem;
				color: #3e2723;
				border-bottom: 1px dashed #3e2723;
				padding-bottom: 8px;
				margin-top: 32px;
			}

			main.form-main h3 {
				font-family: 'Crimson Text', serif;
				color: #3e2723;
				font-size: 1.05rem;
				margin-bottom: 4px;
			}

			main.form-main p {
				line-height: 1.6;
			}

			main.form-main a {
				color: #6b4423;
				text-decoration: underline;
			}

			.stamp-field {
				margin-bottom: 20px;
			}

			.stamp-field label,
			.stamp-checkbox label {
				display: block;
				font-weight: 700;
				text-transform: uppercase;
				font-size: 0.82rem;
				letter-spacing: 0.5px;
				margin-bottom: 6px;
				color: #3e2723;
			}

			.stamp-field input[type="text"],
			.stamp-field input[type="email"],
			.stamp-field input[type="password"],
			.stamp-field input[type="number"],
			.stamp-field select,
			.stamp-field textarea {
				width: 100%;
				box-sizing: border-box;
				font-family: 'Crimson Text', serif;
				font-size: 1rem;
				padding: 10px 12px;
				background: #e9dcc9;
				border: 1px solid #3e2723;
				border-radius: 2px;
				color: #1a1a1a;
			}

			.stamp-field input:focus,
			.stamp-field select:focus,
			.stamp-field textarea:focus {
				outline: 2px solid #d4af37;
				outline-offset: 1px;
			}

			.stamp-checkbox {
				display: flex;
				align-items: flex-start;
				gap: 10px;
				margin-bottom: 20px;
				font-size: 0.95rem;
			}
			.stamp-checkbox input {
				margin-top: 4px;
			}
			.stamp-checkbox label {
				text-transform: none;
				font-weight: 400;
				font-size: 0.95rem;
			}

			.stamp-fieldset {
				border: 1px dashed #3e2723;
				border-radius: 4px;
				padding: 20px;
				margin-bottom: 24px;
				background: rgba(233, 220, 201, 0.25);
			}
			.stamp-fieldset legend {
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 1px;
				padding: 0 8px;
				color: #3e2723;
				font-family: 'Crimson Text', serif;
			}

			.stamp-btn {
				font-family: 'Crimson Text', serif !important;
				font-weight: 700 !important;
				font-size: 1.05rem !important;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: #1a1a1a !important;
				background: #e9dcc9 !important;
				padding: 10px 26px !important;
				border: 1px solid #3e2723;
				box-shadow: 4px 4px 0px #d4af37;
				cursor: pointer;
				display: inline-block;
				transform: rotate(-1deg);
				transition: all 0.2s ease;
			}
			.stamp-btn:hover {
				background: #1a1a1a !important;
				color: #fdfaf1 !important;
				transform: rotate(0deg) translateY(-3px);
			}
			.stamp-btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.form-error {
				color: #b03a2e;
				font-weight: 700;
				margin-top: 10px;
			}
			.form-success {
				color: #2e7d32;
				font-weight: 700;
				margin-top: 10px;
			}

			@media (max-width: 700px) {
				main.form-main {
					max-width: 100%;
					width: 92%;
					margin: 30px auto;
					padding: 20px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class:list={["form-main", { wide }]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
