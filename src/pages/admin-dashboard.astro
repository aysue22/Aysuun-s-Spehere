---
import FormPage from '../layouts/FormPage.astro';
import { isAdminAuthenticated } from "../lib/admin-auth";
export const prerender = false;
const alreadyAuthed = await isAdminAuthenticated(Astro.cookies);
---
<FormPage title="Araştırma Dashboard — The Coven Journal" description="Sosyolojik araştırma verileri paneli." wide={true}>
  <style is:global>
    #login-box { max-width: 320px; margin: 20px auto; }
    #login-box .stamp-field { margin-bottom: 14px; }

    .stat-cards { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
    .stat-card {
      flex: 1; min-width: 160px;
      border: 1px solid #3e2723; border-radius: 4px; padding: 16px; text-align: center;
      background: #e9dcc9;
    }
    .stat-card .num { font-size: 2rem; font-weight: bold; color: #1a1a1a; }
    .stat-card .label { color: #6b4423; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; }

    .bar-row { display: flex; align-items: center; margin: 4px 0; font-size: 0.9rem; }
    .bar-label { width: 200px; flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #2c2c2c; }
    .bar-track { flex: 1; background: #e9dcc9; border-radius: 3px; overflow: hidden; height: 16px; margin: 0 8px; border: 1px solid #3e2723; }
    .bar-fill { background: #d4af37; height: 100%; }
    .bar-count { width: 40px; text-align: right; color: #6b4423; }

    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #d4af37; }
    th { color: #3e2723; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.5px; }
  </style>

  <div id="login-box" style={alreadyAuthed ? "display:none" : ""}>
    <h1>// Admin Girişi</h1>
    <div class="stamp-field">
      <label for="pwd">Şifre</label>
      <input type="password" id="pwd" />
    </div>
    <button id="login-btn" class="stamp-btn">Giriş Yap</button>
    <p class="form-error" id="login-error"></p>
  </div>

  <div id="dashboard" style={alreadyAuthed ? "" : "display:none"}>
    <h1>// Araştırma Dashboard</h1>
    <div id="content">Yükleniyor...</div>
  </div>
</FormPage>

<script>
  async function loadStats() {
    const res = await fetch("/api/admin/stats");
    if (res.status === 401) {
      document.getElementById("dashboard")!.style.display = "none";
      document.getElementById("login-box")!.style.display = "block";
      return;
    }
    const data = await res.json();
    render(data);
  }

  function barChart(rows: { label: string; count: number }[], maxWidth = 100) {
    const max = Math.max(...rows.map((r) => r.count), 1);
    return rows
      .map(
        (r) => `
      <div class="bar-row">
        <div class="bar-label">${escapeHtml(r.label)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(r.count / max) * maxWidth}%"></div></div>
        <div class="bar-count">${r.count}</div>
      </div>`
      )
      .join("");
  }

  function escapeHtml(s: string) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function render(data: any) {
    const c = document.getElementById("content")!;

    let html = `
      <div class="stat-cards">
        <div class="stat-card"><div class="num">${data.totalUsers}</div><div class="label">Toplam Kayıtlı Kullanıcı</div></div>
        <div class="stat-card"><div class="num">${data.totalSurveyResponses}</div><div class="label">Anketi Dolduran Kullanıcı</div></div>
      </div>
    `;

    html += `<h2>Demografik Dağılım</h2>`;
    const demoLabels: Record<string, string> = {
      age_range: "Yaş Aralığı",
      gender: "Cinsiyet",
      education_level: "Eğitim Düzeyi",
      occupation_status: "Meslek / Çalışma Durumu",
      settlement_type: "Yerleşim Tipi",
      country: "Ülke",
    };
    for (const [key, label] of Object.entries(demoLabels)) {
      html += `<h3>${label}</h3>${barChart(data.demographics[key])}`;
    }

    html += `<h2>En Çok Okunan Yazılar</h2><table>
      <tr><th>Yazı (slug)</th><th>Görüntülenme</th><th>Ort. Süre (sn)</th></tr>
      ${data.topPosts
        .map(
          (p: any) =>
            `<tr><td>${escapeHtml(p.post_slug)}</td><td>${p.views}</td><td>${
              p.avg_seconds ? Math.round(p.avg_seconds) : "-"
            }</td></tr>`
        )
        .join("")}
    </table>`;

    html += `<h2>Anket Cevap Dağılımları</h2>`;
    const bySection: Record<string, any[]> = {};
    for (const q of data.surveyBreakdown) {
      (bySection[q.section] ??= []).push(q);
    }
    for (const [section, qs] of Object.entries(bySection)) {
      html += `<h3 style="margin-top:20px;">${section}</h3>`;
      for (const q of qs as any[]) {
        const rows = Object.entries(q.tally).map(([label, count]) => ({ label, count: count as number }));
        if (rows.length === 0) continue;
        html += `<p style="margin-bottom:2px;"><strong>${escapeHtml(q.question_text)}</strong> <span style="color:#6b4423;">(${q.response_count} cevap)</span></p>`;
        html += barChart(rows);
      }
    }

    html += `<h2>Kullanıcı Bazlı Detay</h2>
      <p style="font-size:0.85rem;color:#6b4423;">E-posta gösterilmez, sadece anonim numara. Bir kullanıcıya tıklayınca cevaplarını ve okuduğu yazıları görürsünüz.</p>
      <div id="user-list"></div>
      <div id="user-detail" style="display:none; margin-top:20px; border-top:2px dashed #3e2723; padding-top:16px;"></div>

      <h2>Bekleyen Collective Gönderileri</h2>
      <div id="pending-submissions"></div>

      <h2>Yorumlar</h2>
      <p style="font-size:0.85rem;color:#6b4423;">Yorumlar direkt yayınlanır (moderasyonsuz), ama uygunsuz olanları buradan silebilirsiniz.</p>
      <div id="comments-list"></div>`;

    c.innerHTML = html;
    loadUserList();
    loadPendingSubmissions();
    loadComments();
  }

  async function loadComments() {
    const res = await fetch("/api/admin/comments");
    const data = await res.json();
    const container = document.getElementById("comments-list")!;

    if (data.comments.length === 0) {
      container.innerHTML = `<p style="color:#6b4423;">Henüz yorum yok.</p>`;
      return;
    }

    container.innerHTML = `<table>
      <tr><th>Kullanıcı</th><th>Sayfa</th><th>Yorum</th><th>Tarih</th><th></th></tr>
      ${data.comments
        .map(
          (c: any) => `
        <tr data-comment-id="${c.id}">
          <td>#${c.user_id}</td>
          <td>${escapeHtml(c.post_slug)}</td>
          <td>${escapeHtml(c.comment_text)}</td>
          <td>${escapeHtml(c.created_at)}</td>
          <td><button class="stamp-btn" style="padding:4px 12px !important; font-size:0.8rem !important; background:#f5e5e0 !important;" data-delete-id="${c.id}">Sil</button></td>
        </tr>`
        )
        .join("")}
    </table>`;

    container.querySelectorAll<HTMLButtonElement>("button[data-delete-id]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Bu yorumu silmek istediğinize emin misiniz?")) return;
        await fetch("/api/admin/comments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ comment_id: btn.dataset.deleteId }),
        });
        loadComments();
      });
    });
  }

  async function loadPendingSubmissions() {
    const res = await fetch("/api/admin/collective-submissions?status=pending");
    const data = await res.json();
    const container = document.getElementById("pending-submissions")!;

    if (data.submissions.length === 0) {
      container.innerHTML = `<p style="color:#6b4423;">Bekleyen gönderi yok.</p>`;
      return;
    }

    container.innerHTML = data.submissions
      .map(
        (s: any) => `
      <div class="stamp-fieldset" data-submission-id="${s.id}">
        <p><strong>${escapeHtml(s.project_name)}</strong> ${s.tag ? `· <span style="color:#6b4423;">${escapeHtml(s.tag)}</span>` : ""}</p>
        <p>${escapeHtml(s.short_desc)}</p>
        ${s.link ? `<p><a href="${escapeHtml(s.link)}" target="_blank">${escapeHtml(s.link)}</a></p>` : ""}
        ${s.content ? `<p style="white-space:pre-wrap; font-size:0.9rem; background:#e9dcc9; padding:10px; border-radius:2px;">${escapeHtml(s.content)}</p>` : ""}
        <div style="display:flex; gap:10px; margin-top:10px;">
          <button class="stamp-btn" style="padding:6px 16px !important; font-size:0.85rem !important;" data-action="approve" data-id="${s.id}">✔ Onayla ve .md indir</button>
          <button class="stamp-btn" style="padding:6px 16px !important; font-size:0.85rem !important; background:#f5e5e0 !important;" data-action="reject" data-id="${s.id}">✕ Reddet</button>
        </div>
      </div>`
      )
      .join("");

    container.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id!;
        const action = btn.dataset.action === "approve" ? "approved" : "rejected";

        if (action === "approved") {
          const sub = data.submissions.find((s: any) => String(s.id) === id);
          downloadMarkdown(sub);
        }

        await fetch("/api/admin/collective-submissions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ submission_id: id, action }),
        });

        loadPendingSubmissions();
      });
    });
  }

  function yamlStr(val: string | null) {
    if (val === undefined || val === null) return '""';
    const escaped = String(val).replace(/"/g, '\\"').replace(/\n/g, " ");
    return `"${escaped}"`;
  }

  function downloadMarkdown(sub: any) {
    let frontmatter = "---\n";
    frontmatter += `projectName: ${yamlStr(sub.project_name)}\n`;
    frontmatter += `tag: ${yamlStr(sub.tag)}\n`;
    frontmatter += `shortDesc: ${yamlStr(sub.short_desc)}\n`;
    if (sub.link) frontmatter += `link: ${yamlStr(sub.link)}\n`;
    frontmatter += "---\n";
    if (sub.content) frontmatter += "\n" + sub.content;

    const blob = new Blob([frontmatter], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${sub.slug}.md`;
    a.click();
    URL.revokeObjectURL(url);
  }

  async function loadUserList() {
    const res = await fetch("/api/admin/user-detail");
    const data = await res.json();
    const container = document.getElementById("user-list")!;
    container.innerHTML = `<table>
      <tr><th>Kullanıcı</th><th>Yaş</th><th>Cinsiyet</th><th>Meslek</th><th>Okuduğu Yazı</th><th>Anket Cevabı</th><th></th></tr>
      ${data.users
        .map(
          (u: any) => `
        <tr>
          <td>#${u.id}</td>
          <td>${escapeHtml(u.age_range || "-")}</td>
          <td>${escapeHtml(u.gender || "-")}</td>
          <td>${escapeHtml(u.occupation_status || "-")}</td>
          <td>${u.post_view_count}</td>
          <td>${u.survey_answer_count}</td>
          <td><button class="stamp-btn" style="padding:4px 12px !important; font-size:0.8rem !important;" data-user-id="${u.id}">Detay</button></td>
        </tr>`
        )
        .join("")}
    </table>`;

    container.querySelectorAll<HTMLButtonElement>("button[data-user-id]").forEach((btn) => {
      btn.addEventListener("click", () => loadUserDetail(btn.dataset.userId!));
    });
  }

  async function loadUserDetail(userId: string) {
    const res = await fetch(`/api/admin/user-detail?user_id=${userId}`);
    const data = await res.json();
    const container = document.getElementById("user-detail")!;
    container.style.display = "block";

    const u = data.user;
    let html = `<h3>Kullanıcı #${u.id} — Profil</h3>
      <p>
        Yaş: <strong>${escapeHtml(u.age_range || "-")}</strong> ·
        Cinsiyet: <strong>${escapeHtml(u.gender || "-")}</strong> ·
        Eğitim: <strong>${escapeHtml(u.education_level || "-")}</strong> ·
        Meslek: <strong>${escapeHtml(u.occupation_status || "-")}</strong> ·
        Şehir: <strong>${escapeHtml(u.city || "-")}</strong> ·
        Yerleşim: <strong>${escapeHtml(u.settlement_type || "-")}</strong>
      </p>`;

    html += `<h3>Okuduğu Yazılar (${data.postViews.length})</h3>`;
    if (data.postViews.length === 0) {
      html += `<p style="color:#6b4423;">Henüz hiçbir yazı görüntülememiş.</p>`;
    } else {
      html += `<table><tr><th>Yazı</th><th>Süre (sn)</th><th>Tarih</th></tr>
        ${data.postViews
          .map(
            (pv: any) =>
              `<tr><td>${escapeHtml(pv.post_slug)}</td><td>${pv.time_spent_seconds ?? "-"}</td><td>${escapeHtml(pv.viewed_at)}</td></tr>`
          )
          .join("")}
      </table>`;
    }

    html += `<h3>Anket Cevapları (${data.surveyAnswers.length})</h3>`;
    if (data.surveyAnswers.length === 0) {
      html += `<p style="color:#6b4423;">Anketi henüz doldurmamış.</p>`;
    } else {
      for (const a of data.surveyAnswers) {
        let displayAnswer = a.answer_text;
        if (a.question_type === "multi_choice") {
          try {
            displayAnswer = JSON.parse(a.answer_text).join(", ");
          } catch {}
        }
        html += `<p style="margin-bottom:6px;"><strong>${escapeHtml(a.question_text)}</strong><br/>${escapeHtml(displayAnswer)}</p>`;
      }
    }

    container.innerHTML = html;
    container.scrollIntoView({ behavior: "smooth" });
  }

  document.getElementById("login-btn")?.addEventListener("click", async () => {
    const pwd = (document.getElementById("pwd") as HTMLInputElement).value;
    const res = await fetch("/api/admin/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ password: pwd }),
    });
    if (!res.ok) {
      const data = await res.json();
      document.getElementById("login-error")!.textContent = data.error || "Hata oluştu.";
      return;
    }
    document.getElementById("login-box")!.style.display = "none";
    document.getElementById("dashboard")!.style.display = "block";
    loadStats();
  });

  if ((document.getElementById("dashboard") as HTMLElement).style.display !== "none") {
    loadStats();
  }
</script>
